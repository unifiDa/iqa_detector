# Dataset btb-dresden (ITI) inpainted with jagg: generic inpainting, no faces.
# (replaces jagg.sh)   ./run.sh jagg
NAME=jagg
DATA=/home/dasara/Research/btb-dresden-all

PREPARE=generic                                 # masks are mask_<image up to large|medium|small>.png
INPAINTS=$DATA/jagg_inpaint/
MASKS=$DATA/btb_masks/
PROMPT_JSON=$DATA/miniInternVL_btb_prompts/     # -> make_prompts -> $OUT/prompts.jsonl (id = inpainted file name)
OUT=/home/dasara/Research/results/$NAME/

QUALITY_METRICS=(musiq clipiqa brisque niqe maniqa)

CODE=/home/dasara/Research/code/iqa_detector
MPS_CKPT=$CODE/Weights/MPS_overall_checkpoint.pth
MPS_REPO=$CODE/MPS/
