# Template for a new dataset:   cp datasets/template.env datasets/mydataset.env   then   ./run.sh mydataset
# This file is sourced by bash (run.sh). Only INPAINTS and OUT are required; everything else enables more steps.
# `./run.sh mydataset --list` shows which steps your config enables.

NAME=mydataset                          # name stored in summary.json (default: the file name)

# ---- images and masks (required) --------------------------------------------------------------
INPAINTS=/path/to/edited/images/        # the images to evaluate
OUT=/path/to/results/mydataset/         # everything is written here
MASKS=/path/to/masks/                   # optional: the edited region; without masks the region is the face or the whole image

# Do the images contain faces to evaluate?
#   faces   -> prepare.py: insightface finds the face (crop kinds face / mask / full)
#   generic -> prepare_generic.py: no face detection (crop kinds mask / full)
PREPARE=generic

# How are masks named? Default for `faces`:   <image>_inpainted-N.png -> <image>_mask.png
# Default for `generic`: <image up to large|medium|small>.png -> mask_<that>.png
# Any other scheme is described with a regex on the image name (no extension) and a template that
# uses its groups ({base}, {0}, {1}, ... and {stem}); examples:
#   image  img_0012_edit.png  ->  mask  img_0012.png
#     PREPARE_ARGS=(--mask-regex '^(?P<base>.*)_edit$' --mask-template '{base}')
#   image  0012.jpg  ->  mask  0012_m.png          (and black = edited area: add --invert)
#     PREPARE_ARGS=(--mask-regex '^(?P<base>.*)$' --mask-template '{base}_m')
# PREPARE_ARGS=()

# ---- reference for FID/KID (optional) ---------------------------------------------------------
# ORIGINALS=/path/to/original/images/   # enables prepare_orig + dataset (FID/KID against the originals' crops)
# OUT_ORIG=/path/to/results/mydataset-original/    # default: <OUT>-original/
# REF_DIR=...                           # default: <OUT_ORIG>/crops/face  (use .../crops/mask for generic datasets)
# DATASET_ARGS=(--kind mask)            # which crops of OUT to compare (default: the most frequent kind)

# ---- prompts (optional) -----------------------------------------------------------------------
# A ready prompts file (jsonl/csv/tsv) enables the CLIP score:
# PROMPTS=/path/to/prompts.jsonl
# PROMPT_COLS=(--id-key image_id --prompt-key caption)   # if the columns are not {record_id, prompt}
# Or convert prompt JSON files first (make_prompts.py writes $OUT/prompts.jsonl):
# PROMPT_JSON=/path/to/prompt_json/
# PROMPT_JSON_ARGS=(--id-template '{name}_{i}_inpainted')

# ---- metrics ----------------------------------------------------------------------------------
# QUALITY_METRICS=(musiq clipiqa brisque niqe maniqa)    # default: all of b_quality.py (topiq_nr-face needs faces)
# MPS score (needs PROMPTS; the checkpoint is not in the repo, see README):
# MPS_CKPT=/path/to/MPS_overall_checkpoint.pth
# MPS_REPO=/path/to/MPS/                # cloned Kwai-Kolors/MPS repo (the folder that contains trainer/)

# ---- age estimation and filtering of the colour images without minors (datasets with faces) ----
# AGE=1
# AGE_ARGS=(--crops)                    # classify the face crops instead of the full frames
# FILTER=1                              # needs AGE=1
# BY_FRAME=1                            # a minor discards the whole frame...
# FRAME_REGEX='(clip_\d+)'              # ...identified by this regex at the start of the file name (default frame_<number>)
# FILTER_ARGS=(--max-color-dev 0.02)

# ---- execution --------------------------------------------------------------------------------
# ENV_NAME=cpu                          # pixi environment for the torch steps: gpu (default) | cpu
# DEVICE=cuda:1                         # default cuda:0 (cpu with ENV_NAME=cpu)
