# Dataset "Archive" / LESC: fooocus-cinematic inpainting of faces from archive frames.
# (replaces lamarr.sh)   ./run.sh lamarr
NAME=lamarr
BASE=/Scratch/Shullani/Dataset

PREPARE=faces                                   # insightface finds the face; masks follow <frame>_inpainted-N.png -> <frame>_mask.png
INPAINTS=$BASE/fooocus-cinematic/inpaints/
MASKS=$BASE/fooocus-cinematic/masks/
ORIGINALS=$BASE/fooocus-cinematic/original/     # prepared into OUT_ORIG, reference of FID/KID
PROMPTS=$BASE/fooocus-cinematic/prompts.jsonl
OUT=$BASE/results/
OUT_ORIG=$BASE/results-original/

MPS_ROOT=/data/staff/shullani/Documents/Research/IAPP/DETECTOR/iqa_detector
MPS_CKPT=$MPS_ROOT/Weights/MPS_overall_checkpoint.pth
MPS_REPO=$MPS_ROOT/MPS/

AGE=1                                           # age of the faces + filter of the colour images without minors
FILTER=1
BY_FRAME=1                                      # a minor discards the whole frame (frame_<number> in the file name)
